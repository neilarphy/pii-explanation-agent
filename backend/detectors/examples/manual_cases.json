    {
      "id": "ru_name",
      "text": "Меня зовут Анна Иванова.",
      "expected": [
        {
          "type": "PERSON",
          "text": "Анна Иванова"
        }
      ],
      "allowed": [
        {
          "type": "PERSON",
          "text": "Анна"
        },
        {
          "type": "PERSON",
          "text": "Иванова"
        }
      ]
    },
    {
