---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	gather(gather)
	decide(decide)
	verify(verify)
	retry(retry)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> gather;
	decide --> verify;
	gather --> decide;
	retry --> decide;
	verify -.-> finish;
	verify -.-> retry;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
